{
    // cult.json — Культ шестерых event clan, loaded as CultBalance.

    // invented: any id no real clan uses; members keep it across renames.
    "clan_id": 6,

    // recovered (player memory): the clan was named КУЛЬТ.
    "clan_name": "КУЛЬТ",

    // invented: ClanRank for /cult join without a rank (3 = Neophyte).
    "member_rank": "Neophyte",

    // recovered (2004 forum: "респ на Тантале"; player memory: at a tower). World x, y, z, turn;
    // Тантал is the island north of Hyperion past the bridge (CoordsHelper Мост_Тантал 1197, 159.9,
    // 1315); this is the Обратно_С_Харона point by the portal ring in its village. null keeps the
    // nearest city. /cult here stores a point in the DB, which wins over this.
    "respawn": [1141.93, 157.94, 1630.65, -1.53],

    // recovered (Игромания 2004: members became crater dwarves; client turnskin.cfg SK01 = npc80):
    // turnskin number given on joining, sent as specab byte 2. 0 gives none.
    "skin_number": 1,

    // recovered (2004 cult fiction: "несмотря на благую карму начали выпадать порошки"; player
    // memory: karma worked the other way round and changed drops). The drop is the member's own bag
    // on death. invented: the numbers, written as an ordinary player's odds; members read them
    // through the mirrored tier, so a member with benign karma uses the very bad row.
    "death_drop_chance_per_karma": {
        "Очень_Плохая": 0.8,
        "Плохая": 0.5,
        "Нейтральная": 0.2,
        "Хорошая": 0.05,
        "Благая": 0.0
    },

    // invented: at most this many bag items per death.
    "death_drop_max_items": 1,

    // invented: mob loot odds per karma tier; all 1.0 because the recovered drop is the death drop.
    "drop_chance_multiplier_per_karma": {
        "Очень_Плохая": 1.0,
        "Плохая": 1.0,
        "Нейтральная": 1.0,
        "Хорошая": 1.0,
        "Благая": 1.0
    },

    // invented: extra mob loot items per karma tier; all 0 for the same reason.
    "extra_drop_items_per_karma": {
        "Очень_Плохая": 0,
        "Плохая": 0,
        "Нейтральная": 0,
        "Хорошая": 0,
        "Благая": 0
    },

    // invented: off keeps the stock drop odds for everyone outside the clan.
    "karma_drops_for_non_members": false
}
